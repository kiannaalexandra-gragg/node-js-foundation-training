# Dependencies
node_modules/

# Environment files: never commit real values, commit .env.example instead
.env
.env.test

# SQLite database files, and the journal files SQLite leaves beside one while it writes (or after a crash)
*.db
*.db-journal
*.db-wal
*.db-shm

# Generated Prisma client (generated in src/generated/prisma/, so match at any depth)
**/generated/prisma

# Build and test output
dist/
coverage/

# Editor and OS files
.DS_Store
.vscode/

# M03 generated files: the ~100 MB log and the CLI's default report. Regenerate them.
modules/m03-nodejs-runtime-npm/data/
modules/m03-nodejs-runtime-npm/report.json
