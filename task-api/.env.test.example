# Settings for the tests: copy this file to .env.test in this folder. Never commit .env.test.
# The values below are fake examples. `npm test` loads .env.test, and in CI the workflow sets the same variables.

# The API key the tests send in the X-API-Key header.
API_KEY=test-api-key

# The name every test database starts from. Each test run adds its process id and the time (test-<pid>-<time>.db),
# so two runs at once never share a file, and deletes it when it ends. The name must start with "test" and end
# in ".db": tests/global-setup.ts and resetDb() refuse anything else, so a run can never wipe dev.db.
DATABASE_URL=file:./test.db

# Keeps the test output quiet.
NODE_ENV=test
LOG_QUERIES=false
