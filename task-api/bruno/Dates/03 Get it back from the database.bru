meta {
  name: 03 Get it back from the database
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/tasks/{{dateId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  // The early year survives the trip through SQLite.
  test("stores the due date as 0050-06-15T00:00:00.000Z", function () {
    expect(res.body.dueDate).to.equal("0050-06-15T00:00:00.000Z");
  });
}
