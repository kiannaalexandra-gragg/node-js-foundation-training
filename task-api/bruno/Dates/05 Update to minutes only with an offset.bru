meta {
  name: 05 Update to minutes only with an offset
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/v1/tasks/{{dateId}}
  body: json
  auth: none
}

body:json {
  { "dueDate": "2026-01-01T10:00+08:00" }
}

assert {
  res.status: eq 200
}

tests {
  // Minutes without seconds is accepted, and the offset is applied: 10:00 at +08:00 is 02:00 UTC.
  test("stores the due date as 2026-01-01T02:00:00.000Z", function () {
    expect(res.body.dueDate).to.equal("2026-01-01T02:00:00.000Z");
  });
}
