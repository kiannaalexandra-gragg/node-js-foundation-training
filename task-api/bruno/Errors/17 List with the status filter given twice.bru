meta {
  name: 17 List with the status filter given twice
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/api/v1/tasks?status=todo&status=done
  body: none
  auth: none
}

assert {
  res.status: eq 400
  res.body.error.code: eq VALIDATION_ERROR
}

tests {
  test("rejects the filter instead of ignoring it", function () {
    expect(res.body.error.details).to.eql([
      { path: "status", message: "Must be one of: todo, in_progress, done" },
    ]);
  });
}
