meta {
  name: 22 Malformed JSON without a key
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/api/v1/tasks
  body: text
  auth: none
}

headers {
  content-type: application/json
}

body:text {
  {bad
}

assert {
  res.status: eq 401
  res.body.error.code: eq UNAUTHORIZED
}

script:pre-request {
  req.deleteHeader("x-api-key");
}

tests {
  test("is rejected for the missing key before the body is read", function () {
    expect(res.body.error.message).to.equal("Missing or invalid API key");
  });
}
