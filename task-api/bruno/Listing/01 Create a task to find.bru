meta {
  name: 01 Create a task to find
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/tasks
  body: json
  auth: none
}

body:json {
  {
    "title": "Listing probe zebra",
    "priority": 1,
    "dueDate": "2026-12-31"
  }
}

assert {
  res.status: eq 201
  res.body.priority: eq 1
}

tests {
  test("stores the due date as a date-time", function () {
    expect(res.body.dueDate).to.equal("2026-12-31T00:00:00.000Z");
  });
}

vars:post-response {
  listingId: res.body.id
}
