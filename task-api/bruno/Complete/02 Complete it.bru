meta {
  name: 02 Complete it
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/api/v1/tasks/{{completeId}}/complete
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.id: eq {{completeId}}
  res.body.status: eq done
}

tests {
  test("leaves the other fields unchanged", function () {
    expect(res.body.title).to.equal("Complete probe");
    expect(res.body.priority).to.equal(1);
  });
}
