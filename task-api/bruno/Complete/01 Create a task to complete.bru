meta {
  name: 01 Create a task to complete
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/tasks
  body: json
  auth: none
}

body:json {
  {
    "title": "Complete probe",
    "status": "in_progress",
    "priority": 1
  }
}

assert {
  res.status: eq 201
  res.body.status: eq in_progress
}

vars:post-response {
  completeId: res.body.id
}
