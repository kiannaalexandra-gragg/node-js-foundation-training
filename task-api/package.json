{
  "name": "task-api",
  "version": "1.0.0",
  "private": true,
  "description": "Task API: an Express 5 REST API in TypeScript, built up from M05 (v1) to M09 (v4)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "bruno": "cd bruno && bru run --env local"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@usebruno/cli": "^4.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
