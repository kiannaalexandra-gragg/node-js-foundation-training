# Settings for the Task API: copy this file to .env in this folder.
# npm run dev and npm start load .env if it exists, and so does the Prisma CLI (see prisma7.config.ts). Never commit .env. The values below are fake examples.

# The port the API listens on (optional, default 3000).
PORT=3000

# development, production or test (optional, default development).
NODE_ENV=development

# The API key every /api/v1 request must send in the X-API-Key header (required, the server will not start without it).
API_KEY=example-api-key-change-me

# Origins allowed by CORS, comma-separated (optional, default * which allows any origin).
CORS_ORIGIN=*

# Module 7: the SQLite database file, relative to task-api/ (required, the server will not start without it).
DATABASE_URL=file:./dev.db

# Set to true to print the SQL Prisma runs for every call (optional, default off).
LOG_QUERIES=false
